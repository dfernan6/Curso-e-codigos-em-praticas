<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Registre</title>
    <link rel="stylesheet" href="./resource/style.css">
</head>
<body>
    <a href="./?page=login"><h1>Scuba<span>PHP</span></h1></a>
    <form action="/?page=register&from=register" method="POST">
        <p>Cadastre Um Novo Usuário</p>

        <div class="mensagem-sucesso">
            <p>{{success_message}}</p>
        </div>

        <label for="nome">Nome</label>
        <input type="text" name="person[name]" value="{{old_name}}" required>
        <span class="mensagem-erro">{{error_name}}</span>

        <label for="email">E-mail</label>
        <input type="email" name="person[email]" value="{{old_email}}" required>
        <span class="mensagem-erro">{{error_email}}</span>

        <label for="senha">Senha</label>
        <input type="password" name="person[password]" required>
        <span class="mensagem-erro">{{error_password}}</span>

        <label for="repita-senha">Repita Senha</label>
        <input type="password" name="person[password-confirm]" required>
        <span class="mensagem-erro">{{error_password-confirm}}</span>

        <input type="submit" value="Salvar">
    </form>
</body>
</html>

