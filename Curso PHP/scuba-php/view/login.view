<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login</title>
    <link rel="stylesheet" href="./resource/style.css">
</head>
<body>
    <h1>Scuba<span>PHP</span></h1>
    <form action="/?page=login&from=login" method="POST">
        <div class="mensagem-sucesso">
            <p>Welcome to ScubaPHP</p>
        </div>

        <label for="email">Email</label>
        <input type="text" id="email" name="person[email]" value="{{old_email}}" required>
        <span class="mensagem-erro">{{error_email}}</span>

        <label for="password">Senha</label>
        <input type="password" id="password" name="person[password]" required>
        <span class="mensagem-erro">{{error_password}}</span>

        <button>Entrar</button>
        <a href="./?page=register">Cadastrar Usuário</a>
        <a href="./?page=forget-password">Esqueci Minha Senha</a>
    </form>
</body>
</html>
