<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="./resource/style.css">
    <title>Alterar Senha</title>
</head>
<body>
    <a href="./"><h1>Scuba<span>PHP</span></h1></a>
    <form action="./?page=change-password" method="post">
        <!-- carry token from GET into POST -->
        <input type="hidden" name="token" value="{{token}}">

        <div class="mensagem-sucesso">
            <p>{{success_message}}</p>
        </div>

        <p>Alterar Senha</p>

        <label for="senha">Nova Senha</label>
        <input type="password" id="senha" name="password" required>
        <span class="mensagem-erro">{{error_password}}</span>

        <label for="repita-senha">Repita Senha</label>
        <input type="password" id="repita-senha" name="password_confirm" required>
        <span class="mensagem-erro">{{error_password_confirm}}</span>

        <span class="mensagem-erro">{{error_general}}</span>

        <input type="submit" value="Salvar">
    </form>
</body>
</html>
